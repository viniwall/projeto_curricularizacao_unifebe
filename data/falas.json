{
  "versao": 1,
  "descricao": "Falas do Órbi fora das perguntas. \"texto\" é o que ele diz; \"arquivo\" é a gravação; \"pronuncia\" (quando existe) é o texto usado para gerar a voz.",
  "frases": {
    "ola": {
      "texto": "Oi! Eu sou o Órbi, seu robô ajudante.",
      "arquivo": "assets/audio/falas/ola.mp3"
    },
    "qual_nome": {
      "texto": "Qual é o seu nome?",
      "arquivo": "assets/audio/falas/qual_nome.mp3"
    },
    "peca_adulto": {
      "texto": "Peça para um adulto ajudar a escrever o seu nome completo.",
      "arquivo": "assets/audio/falas/peca_adulto.mp3"
    },
    "prazer": {
      "texto": "Muito prazer!",
      "arquivo": "assets/audio/falas/prazer.mp3"
    },
    "escolha_nave": {
      "texto": "Agora escolha a cor da sua nave.",
      "arquivo": "assets/audio/falas/escolha_nave.mp3"
    },
    "nave_bonita": {
      "texto": "Que nave bonita!",
      "arquivo": "assets/audio/falas/nave_bonita.mp3"
    },
    "toque_continuar": {
      "texto": "Toque no botão azul para continuar.",
      "arquivo": "assets/audio/falas/toque_continuar.mp3"
    },
    "escolha_nivel": {
      "texto": "Escolha o nível: | fácil, | médio | ou difícil.",
      "arquivo": "assets/audio/falas/escolha_nivel.mp3"
    },
    "mapa": {
      "texto": "Este é o mapa da expedição.",
      "arquivo": "assets/audio/falas/mapa.mp3"
    },
    "escolha_planeta": {
      "texto": "Escolha um planeta para visitar!",
      "arquivo": "assets/audio/falas/escolha_planeta.mp3"
    },
    "intro_sons": {
      "texto": "Bem-vindo ao Planeta dos Sons! | Aqui a gente escuta sons, bate palmas e brinca com as letras.",
      "arquivo": "assets/audio/falas/intro_sons.mp3"
    },
    "intro_lugares": {
      "texto": "Bem-vindo ao Planeta dos Lugares! | Aqui a gente descobre onde as coisas estão: | dentro, fora, em cima e embaixo.",
      "arquivo": "assets/audio/falas/intro_lugares.mp3"
    },
    "intro_numeros": {
      "texto": "Bem-vindo ao Planeta dos Números! | Aqui a gente conta estrelas, naves e cristais.",
      "arquivo": "assets/audio/falas/intro_numeros.mp3"
    },
    "intro_cores": {
      "texto": "Oh, não! O Planeta das Cores perdeu as cores! | Vamos ajudar a pintar tudo de novo?",
      "arquivo": "assets/audio/falas/intro_cores.mp3"
    },
    "acerto_1": {
      "texto": "Muito bem!",
      "arquivo": "assets/audio/falas/acerto_1.mp3"
    },
    "acerto_2": {
      "texto": "Isso mesmo!",
      "arquivo": "assets/audio/falas/acerto_2.mp3"
    },
    "acerto_3": {
      "texto": "Você conseguiu!",
      "arquivo": "assets/audio/falas/acerto_3.mp3"
    },
    "acerto_4": {
      "texto": "Que legal!",
      "arquivo": "assets/audio/falas/acerto_4.mp3"
    },
    "quase": {
      "texto": "Quase! Tente de novo.",
      "arquivo": "assets/audio/falas/quase.mp3"
    },
    "olha_so": {
      "texto": "Olha só!",
      "arquivo": "assets/audio/falas/olha_so.mp3"
    },
    "proxima": {
      "texto": "Vamos para a próxima!",
      "arquivo": "assets/audio/falas/proxima.mp3"
    },
    "lembrete_1": {
      "texto": "Estou esperando você! | Toque para responder.",
      "arquivo": "assets/audio/falas/lembrete_1.mp3"
    },
    "lembrete_2": {
      "texto": "Quer ouvir de novo? | Toque no alto-falante.",
      "arquivo": "assets/audio/falas/lembrete_2.mp3"
    },
    "parabens": {
      "texto": "Parabéns!",
      "arquivo": "assets/audio/falas/parabens.mp3"
    },
    "explorou_sons": {
      "texto": "Você explorou o Planeta dos Sons!",
      "arquivo": "assets/audio/falas/explorou_sons.mp3"
    },
    "explorou_lugares": {
      "texto": "Você explorou o Planeta dos Lugares!",
      "arquivo": "assets/audio/falas/explorou_lugares.mp3"
    },
    "explorou_numeros": {
      "texto": "Você explorou o Planeta dos Números!",
      "arquivo": "assets/audio/falas/explorou_numeros.mp3"
    },
    "explorou_cores": {
      "texto": "As cores voltaram para o planeta! | Você explorou o Planeta das Cores!",
      "arquivo": "assets/audio/falas/explorou_cores.mp3"
    },
    "premios": {
      "texto": "Olha quantos prêmios você ganhou!",
      "arquivo": "assets/audio/falas/premios.mp3"
    },
    "explorou_todos": {
      "texto": "Você explorou todos os planetas!",
      "arquivo": "assets/audio/falas/explorou_todos.mp3"
    },
    "jogar_de_novo": {
      "texto": "Quer jogar de novo?",
      "arquivo": "assets/audio/falas/jogar_de_novo.mp3"
    },
    "que_bom": {
      "texto": "Que bom brincar com você!",
      "arquivo": "assets/audio/falas/que_bom.mp3"
    },
    "quer_continuar": {
      "texto": "Quer continuar?",
      "arquivo": "assets/audio/falas/quer_continuar.mp3"
    }
  },
